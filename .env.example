# ============================================================
# محادثة فورية — نموذج متغيرات البيئة (انسخه إلى .env وعدّله)
# ============================================================

# قاعدة البيانات — يُفضَّل مسار مطلق
# على ويندوز مثال: file:C:/apps/instant-chat/db/custom.db
DATABASE_URL=file:/absolute/path/to/project/db/custom.db

# ------------------------------------------------------------
# اتصال Socket.IO من المتصفح — اختر حالة واحدة من الثلاث:
# ------------------------------------------------------------
# أ) الإنتاج خلف nginx يمرر /socket.io إلى خدمة المحادثة (الموصى به):
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# ب) اتصال مباشر بدون وكيل (الخدمة تسمح بكل المصادر):
# NEXT_PUBLIC_SOCKET_URL=http://SERVER_IP:3003
# NEXT_PUBLIC_SOCKET_PATH=/socket.io

# ج) بيئة بوابة Caddy من نوع XTransformPort:
# NEXT_PUBLIC_SOCKET_URL=/?XTransformPort=3003
# NEXT_PUBLIC_SOCKET_PATH=/

# ------------------------------------------------------------
# إرسال رمز الدخول SMS حقيقياً (اختياري — فارغ = وضع تجريبي يعرض الرمز بالواجهة)
# ------------------------------------------------------------
# SMS_PROVIDER = twilio | vonage | http
# SMS_PROVIDER=twilio   →  TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM
#                          (تنبيه: Twilio لا يدعم سوريا منذ 9/2025)
# SMS_PROVIDER=vonage   →  VONAGE_API_KEY + VONAGE_API_SECRET + VONAGE_FROM
# SMS_PROVIDER=http     →  بوابة HTTP عامة لأي مزود آخر (يدعم أرقام سوريا مثل
#                          Unimatrix/EasySendSMS): SMS_HTTP_URL يستقبل POST JSON
#                          {to, message} و SMS_HTTP_TOKEN اختياري (Bearer)
# تحسين نص الرسالة (اختياري — أبقِه تحت 70 حرفاً لقطاع SMS واحد):
# OTP_MESSAGE_TEMPLATE=رمز الدخول لمحادثة فورية: {code}

# ------------------------------------------------------------
# بوابة الموبايل (الأرخص — يرسل من باقة رسائل هاتفك الأندرويد):
#   SMS_PROVIDER=relay
#   SMS_RELAY_TOKEN=<رمز سري طويل تختاره بنفسك>
# الهاتف يسحب /api/sms/relay/pending ويرسل ثم يثبت /api/sms/relay/confirm
# السكربت الجاهز للهاتف: public/relay-sms.sh
# ------------------------------------------------------------
